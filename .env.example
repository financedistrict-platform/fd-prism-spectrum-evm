# Network RPC URLs
# Add your RPC endpoints for different networks
TESTNET_RPC_URL=https://bsc-testnet.public.blastapi.io
PRODUCTION_RPC_URL=https://bsc-dataseed1.binance.org

# Per-network RPC overrides (fallbacks exist in hardhat.config.ts).
# Key format: <NETWORK_NAME_UPPER_WITH_UNDERSCORES>_RPC_URL
ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Deployer Private Key
# IMPORTANT: Never commit this file with real private keys!
# Use environment variables or secure secret management in production
# DEPLOYER_PRIVATE_KEY=your_private_key_here

# Initial admin for SpectrumSettlement (DEFAULT_ADMIN_ROLE + FACILITATOR_MANAGER_ROLE).
# Optional on testnet (defaults to deployer EOA). For MAINNET this MUST be a multisig/timelock
# (see plans/.../todo.md — admin hardening required before mainnet go-live).
# INITIAL_ADMIN=0xYourMultisigOrEoa

# Block Explorer API Keys (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# Gas Reporter
REPORT_GAS=false
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
