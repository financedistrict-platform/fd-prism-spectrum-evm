# Network RPC URLs
# Add your RPC endpoints for different networks
TESTNET_RPC_URL=https://bsc-testnet.public.blastapi.io
PRODUCTION_RPC_URL=https://bsc-dataseed1.binance.org

# Deployer Private Key
# IMPORTANT: Never commit this file with real private keys!
# Use environment variables or secure secret management in production
# DEPLOYER_PRIVATE_KEY=your_private_key_here

# Block Explorer API Keys (for contract verification)
BASESCAN_API_KEY=your_basescan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key
ARBISCAN_API_KEY=your_arbiscan_api_key

# Gas Reporter
REPORT_GAS=false
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
